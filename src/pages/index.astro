---
import Base from '../layouts/Base.astro';

const title = 'Kabeli Software Solution | Custom Software & Digital Products UAE';
const description =
  'Kabeli Software Solution FZ-LLC builds custom software, digital platforms, mobile applications, AI systems and IT infrastructure from the UAE.';
---

<Base title={title} description={description} path="/">
<div class="page">

<a class="skip" href="#top">Skip to content</a>
<!-- 00 — Header -->
<header class="hdr hdr-in" style="height: 72px">
  <div class="wrap" style="height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 32px">
    <a href="#top" aria-label="Kabeli — home" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <rect x="2" y="1" width="4" height="20" fill="#141516"></rect>
        <path d="M9 11 L19 1 L19 6.5 L14.5 11 L19 15.5 L19 21 Z" fill="var(--accent)"></path>
      </svg>
      <span style="font-family: Manrope, system-ui, sans-serif; font-weight: 700; font-size: 15px; letter-spacing: 0.22em">KABELI</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a class="ul" href="#services">Services</a>
      <a class="ul" href="#expertise">Expertise</a>
      <a class="ul" href="#company">Company</a>
      <a class="ul" href="#process">Process</a>
      <a class="ul" href="/contact">Contact</a>
    </nav>
    <a class="btn" href="/contact" style="height: 44px; padding: 0 20px; font-size: 14px">Start a Project</a>
    <button class="menu-btn" type="button" aria-label="Menu" aria-controls="mobile-nav" aria-expanded="false" id="menu-btn" style="width: 44px; height: 44px; align-items: center; justify-content: center; background: transparent; border: 1px solid var(--line); border-radius: 2px; color: var(--ink); cursor: pointer">
      <svg class="bars" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 5h16M1 13h16"></path></svg><svg class="x" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 3l12 12M15 3L3 15"></path></svg>
    </button>
  </div>
  <nav id="mobile-nav" class="mnav" aria-label="Mobile" hidden>
    <a href="#services">Services</a>
    <a href="#expertise">Expertise</a>
    <a href="#company">Company</a>
    <a href="#process">Process</a>
    <a href="/contact">Contact</a>
    <a class="btn" href="/contact">Start a Project</a>
  </nav>
</header>

<main id="top" style="display: flex; flex-direction: column">

<!-- 01 — Premium redesigned hero -->
<section class="kb-hero" aria-labelledby="h-hero">
  <div class="wrap kb-hero-shell">
    <div class="kb-hero-top"><span><span class="kb-pulse"></span> INDEPENDENT SOFTWARE & TECHNOLOGY STUDIO</span><span>BASED IN THE UAE · WORKING WORLDWIDE</span></div>
    <div class="kb-hero-grid">
      <div class="kb-hero-copy">
        <p class="kb-eyebrow">ENGINEERING WHAT'S NEXT / 001</p>
        <h1 id="h-hero">We build <em>what's</em><br/>next in <span>digital.</span></h1>
        <p class="kb-hero-description">Digital products built to move businesses forward. From ambitious ideas to intelligent software, we design, develop, and scale experiences that make an impact.</p>
        <div class="kb-hero-actions"><a href="/contact" class="kb-primary">Let's build together <span aria-hidden="true">↗</span></a><a href="#services" class="kb-secondary">Explore our expertise <span aria-hidden="true">↘</span></a></div>
      </div>
      <div class="kb-showcase" aria-label="Illustration of interconnected digital products">
        <div class="kb-orbit kb-orbit-a"></div><div class="kb-orbit kb-orbit-b"></div>
        <div class="kb-glow"></div>
        <div class="kb-product kb-product-main"><div class="kb-window"><span></span><span></span><span></span><b>kabeli / workspace</b></div><div class="kb-ui"><div class="kb-ui-side"><i></i><i></i><i></i><i></i></div><div class="kb-ui-body"><small>PERFORMANCE OVERVIEW</small><strong>Build better.<br/>Go further.</strong><div class="kb-chart"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="kb-ui-bottom"><i></i><i></i><i></i></div></div></div></div>
        <div class="kb-product kb-product-phone"><div class="kb-phone-notch"></div><small>PRODUCT STATUS</small><div class="kb-phone-ring">↗</div><strong>Ideas in<br/>motion.</strong><div class="kb-phone-line"></div><div class="kb-phone-line short"></div></div>
        <div class="kb-floating kb-floating-one"><span class="kb-status-dot"></span> SYSTEMS ONLINE</div><div class="kb-floating kb-floating-two">&lt;/&gt; &nbsp; BUILT TO SCALE</div>
        <span class="kb-showcase-label">DESIGNED FOR THE FUTURE — BUILT FOR TODAY</span>
      </div>
    </div>
    <div class="kb-hero-bottom"><span>STRATEGY <i>✳</i> DESIGN <i>✳</i> ENGINEERING <i>✳</i> INNOVATION</span><a href="#services">SCROLL TO EXPLORE ↓</a></div>
  </div>
</section>
<section class="kb-intro-band"><div class="wrap kb-intro-inner"><p>From the first spark to the final line of code, <strong>we turn complex challenges into remarkable digital experiences.</strong></p><span>01 / THE KABELI APPROACH</span></div></section>

<!-- 02 — Positioning strip -->
<section class="wrap" aria-labelledby="h-pos" style="padding-bottom: 112px">
  <div class="hair rv"></div>
  <div style="padding: 48px 0 56px" class="sechead rv">
    <p class="lbl" style="margin: 0">01 / Positioning</p>
    <div style="display: flex; flex-direction: column; gap: 16px">
      <h2 id="h-pos" class="disp" style="font-size: clamp(30px, 3.2vw, 44px)">Based in the UAE.<br>Built for global business.</h2>
      <p class="mono" style="margin: 0; font-size: 12.5px; color: var(--muted); letter-spacing: .06em">Ras Al Khaimah &nbsp;•&nbsp; United Arab Emirates</p>
    </div>
  </div>
  <div class="cap rv" style="border-top: 1px solid var(--line); padding-top: 28px; row-gap: 12px">
    <span>Software Engineering</span><span class="sl" style="color: var(--line)">/</span>
    <span>Digital Products</span><span class="sl" style="color: var(--line)">/</span>
    <span>Cloud Infrastructure</span><span class="sl" style="color: var(--line)">/</span>
    <span>AI Solutions</span><span class="sl" style="color: var(--line)">/</span>
    <span>Technology Consulting</span>
  </div>
</section>

<!-- 03 — Services -->
<section id="services" class="wrap" aria-labelledby="h-svc" style="padding-bottom: 128px">
  <div class="sechead rv">
    <p class="lbl" style="margin: 0">02 / Services</p>
    <div style="display: grid; gap: 48px; align-items: end" class="why">
      <h2 id="h-svc" class="disp" style="font-size: clamp(32px, 3.6vw, 48px)">Expertise that moves<br/>business forward.</h2>
      <p style="margin: 0; color: var(--muted); max-width: 440px; text-wrap: pretty">Each engagement is scoped to the problem in front of it. Most projects combine two or three of these.</p>
    </div>
  </div>
  <div style="display: flex; flex-direction: column" class="rv">
    <a class="svc" href="/contact">
      <span class="n">01</span>
      <h3 class="disp" style="font-size: 24px; letter-spacing: -0.02em; font-weight: 600">Custom Software Development</h3>
      <p>Internal tools, operational systems and products that don't fit an off-the-shelf package. Designed around the way your business actually operates.</p>
      <div class="tags"><span class="tag">Business systems</span><span class="tag">Workflow tools</span><span class="tag">Portals</span></div>
    </a>
    <a class="svc" href="/contact">
      <span class="n">02</span>
      <h3 class="disp" style="font-size: 24px; letter-spacing: -0.02em; font-weight: 600">Web &amp; Digital Platforms</h3>
      <p>Public websites, customer platforms and e-commerce. Fast, accessible and built to be maintained for years, not months.</p>
      <div class="tags"><span class="tag">Next.js</span><span class="tag">E-commerce</span><span class="tag">CMS</span></div>
    </a>
    <a class="svc" href="/contact">
      <span class="n">03</span>
      <h3 class="disp" style="font-size: 24px; letter-spacing: -0.02em; font-weight: 600">Mobile Application Development</h3>
      <p>iOS and Android applications with a shared codebase where it makes sense, and native work where it doesn't.</p>
      <div class="tags"><span class="tag">Flutter</span><span class="tag">iOS</span><span class="tag">Android</span></div>
    </a>
    <a class="svc" href="/contact">
      <span class="n">04</span>
      <h3 class="disp" style="font-size: 24px; letter-spacing: -0.02em; font-weight: 600">AI &amp; Intelligent Systems</h3>
      <p>Language models and automation applied to real workflows: document processing, assistants, search and classification. Measured, not demoed.</p>
      <div class="tags"><span class="tag">LLM integration</span><span class="tag">Automation</span><span class="tag">Retrieval</span></div>
    </a>
    <a class="svc" href="/contact">
      <span class="n">05</span>
      <h3 class="disp" style="font-size: 24px; letter-spacing: -0.02em; font-weight: 600">Cloud &amp; IT Infrastructure</h3>
      <p>Hosting, networking, backups and deployment pipelines. Set up once, documented, and monitored so it stays that way.</p>
      <div class="tags"><span class="tag">AWS</span><span class="tag">Docker</span><span class="tag">CI/CD</span></div>
    </a>
    <a class="svc" href="/contact">
      <span class="n">06</span>
      <h3 class="disp" style="font-size: 24px; letter-spacing: -0.02em; font-weight: 600">Technology Consulting &amp; Integration</h3>
      <p>Architecture reviews, vendor selection and connecting the systems you already have. Useful when a decision is expensive to get wrong.</p>
      <div class="tags"><span class="tag">Architecture</span><span class="tag">Integration</span><span class="tag">Audits</span></div>
    </a>
  </div>
</section>

<!-- 04 — Expertise (dark) -->
<section id="expertise" class="dark" aria-labelledby="h-exp" style="background: #141516; color: #F4F2ED; padding: 112px 0 120px">
  <div class="wrap">
    <div class="sechead rv" style="padding-bottom: 56px">
      <p class="lbl" style="margin: 0">03 / Expertise</p>
      <div style="display: grid; gap: 48px; align-items: end" class="why">
        <h2 id="h-exp" class="disp" style="font-size: clamp(32px, 3.6vw, 48px)">Technology, thoughtfully applied.</h2>
        <p style="margin: 0; color: var(--dmuted); max-width: 440px; text-wrap: pretty; font-size: 17px">The tools we work in day to day. Listed as capabilities, not partnerships. We choose per project; this is where we are most fluent.</p>
      </div>
    </div>
    <div class="map rv">
      <div class="col"><span class="lbl">Frontend</span><ul><li>React</li><li>Next.js</li><li>TypeScript</li><li>Design systems</li></ul></div>
      <div class="col"><span class="lbl">Mobile</span><ul><li>Flutter</li><li>iOS</li><li>Android</li><li>App Store release</li></ul></div>
      <div class="col"><span class="lbl">Backend</span><ul><li>Node.js</li><li>Python</li><li>REST APIs</li><li>Auth &amp; billing</li></ul></div>
      <div class="col"><span class="lbl">Cloud</span><ul><li>AWS</li><li>Docker</li><li>CI/CD pipelines</li><li>Monitoring</li></ul></div>
      <div class="col"><span class="lbl">Data</span><ul><li>PostgreSQL</li><li>Supabase</li><li>Reporting</li><li>Migrations</li></ul></div>
      <div class="col"><span class="lbl">AI</span><ul><li>LLM integrations</li><li>Retrieval (RAG)</li><li>Document pipelines</li><li>Evaluation</li></ul></div>
      <div class="col"><span class="lbl">Infrastructure</span><ul><li>Networking</li><li>Backups</li><li>Security baseline</li><li>Support &amp; SLAs</li></ul></div>
    </div>
    <p class="mono rv" style="margin: 32px 0 0; font-size: 11px; color: var(--dmuted); letter-spacing: .08em">FIG. 02 — CAPABILITY MAP. PRODUCT NAMES ARE THE PROPERTY OF THEIR RESPECTIVE OWNERS.</p>
  </div>
</section>

<!-- 05 — Process -->
<section id="process" class="wrap" aria-labelledby="h-proc" style="margin-top: 112px; padding-bottom: 128px">
  <div class="sechead rv">
    <p class="lbl" style="margin: 0">04 / How we work</p>
    <div style="display: grid; gap: 48px; align-items: end" class="why">
      <h2 id="h-proc" class="disp" style="font-size: clamp(32px, 3.6vw, 48px)">From vision to launch.</h2>
      <p style="margin: 0; color: var(--muted); max-width: 440px; text-wrap: pretty">The same sequence whether the project is a two-week integration or a year-long platform. Phases overlap; they are not gates.</p>
    </div>
  </div>
  <div class="proc">
    <div class="pv" aria-hidden="true"><i></i></div>
    <div class="ph rv"><span class="mono" style="font-size: 12px; color: var(--accent)">01</span><h3 class="disp" style="font-size: 22px; letter-spacing: -0.02em">Discover</h3><p>We learn how the business works today and what has to change.</p></div>
    <div class="ph rv"><span class="mono" style="font-size: 12px; color: var(--accent)">02</span><h3 class="disp" style="font-size: 22px; letter-spacing: -0.02em">Define</h3><p>Scope, architecture and a plan you can hold us to.</p></div>
    <div class="ph rv"><span class="mono" style="font-size: 12px; color: var(--accent)">03</span><h3 class="disp" style="font-size: 22px; letter-spacing: -0.02em">Design</h3><p>Interfaces and data models, reviewed with the people who will use them.</p></div>
    <div class="ph rv"><span class="mono" style="font-size: 12px; color: var(--accent)">04</span><h3 class="disp" style="font-size: 22px; letter-spacing: -0.02em">Build</h3><p>Short cycles, working software every one of them, tested as we go.</p></div>
    <div class="ph rv"><span class="mono" style="font-size: 12px; color: var(--accent)">05</span><h3 class="disp" style="font-size: 22px; letter-spacing: -0.02em">Launch</h3><p>Deployment, handover and documentation. No surprises on the day.</p></div>
    <div class="ph rv"><span class="mono" style="font-size: 12px; color: var(--accent)">06</span><h3 class="disp" style="font-size: 22px; letter-spacing: -0.02em">Improve</h3><p>Support, monitoring and the next set of changes as the business moves.</p></div>
  </div>
</section>

<!-- 06 — What we build -->
<section class="wrap" aria-labelledby="h-build" style="padding-bottom: 128px">
  <div class="hair rv"></div>
  <div class="sechead rv" style="padding-top: 48px">
    <p class="lbl" style="margin: 0">05 / What we build</p>
    <div style="display: grid; gap: 48px; align-items: end" class="why">
      <h2 id="h-build" class="disp" style="font-size: clamp(32px, 3.6vw, 48px)">Digital products, built with purpose.</h2>
      <p style="margin: 0; color: var(--muted); max-width: 440px; text-wrap: pretty">A look at the digital experiences and systems we can create for your business.</p>
    </div>
  </div>
  <div class="build rv">
    <div class="bc wide">
      <div class="frag">
        <div style="width: 200px; border: 1px solid var(--line); border-radius: 18px; background: var(--paper); padding: 22px 12px 0; display: flex; flex-direction: column; gap: 10px; margin-bottom: -40px">
          <div style="display: flex; justify-content: space-between; align-items: center"><span class="mk" style="color: var(--ink)">Field app</span><span class="chip">Offline-ready</span></div>
          <div class="bar" style="width: 55%; height: 10px; background: var(--ink)"></div>
          <span class="mk">Today's visits</span>
          <div class="row" style="border: 1px solid var(--line); padding: 10px"><div class="bar" style="width: 18px; height: 18px; border-radius: 50%"></div><div class="b" style="flex: 1"></div></div>
          <div class="row" style="border: 1px solid var(--line); padding: 10px"><div class="bar" style="width: 18px; height: 18px; border-radius: 50%"></div><div class="b" style="flex: 1"></div></div>
          <div class="row" style="border: 1px solid var(--accent); padding: 10px"><div class="bar" style="width: 18px; height: 18px; border-radius: 50%; background: var(--accent)"></div><div class="b" style="flex: 1"></div></div>
        </div>
      </div>
      <div class="meta"><span class="lbl">Mobile Platforms</span><p>Customer and field apps, with the backend behind them.</p></div>
    </div>
    <div class="bc s2">
      <div class="frag">
        <div class="win" style="margin-bottom: -30px">
          <div class="tb"><i></i><i></i><i></i><span class="mk" style="margin-left: 6px">Orders · admin</span></div>
          <div class="row" style="background: var(--paper2)"><span class="mk" style="width: 30%">Reference</span><span class="mk" style="width: 20%">Stage</span><span class="mk" style="margin-left: auto">Owner</span></div>
          <div class="row"><div class="b" style="width: 30%"></div><div class="b" style="width: 20%"></div><div class="b" style="width: 15%; margin-left: auto; background: var(--accent)"></div></div>
          <div class="row"><div class="b" style="width: 40%"></div><div class="b" style="width: 15%"></div><div class="b" style="width: 15%; margin-left: auto"></div></div>
          <div class="row"><div class="b" style="width: 25%"></div><div class="b" style="width: 25%"></div><div class="b" style="width: 15%; margin-left: auto"></div></div>
          <div class="row"><div class="b" style="width: 35%"></div><div class="b" style="width: 18%"></div><div class="b" style="width: 15%; margin-left: auto"></div></div>
        </div>
      </div>
      <div class="meta"><span class="lbl">Business Systems</span><p>Operations, records and reporting in one place.</p></div>
    </div>
    <div class="bc s2">
      <div class="frag">
        <div style="width: 100%; display: flex; flex-direction: column; gap: 10px; margin-bottom: -24px">
        <div style="display: flex; gap: 6px; align-items: center"><span class="mk" style="color: var(--ink)">Catalogue</span><span class="chip" style="margin-left: auto">In stock</span><span class="chip">Price</span><span class="chip" style="border-color: var(--accent); color: var(--accent)">Filter</span></div>
        <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; width: 100%">
          <div style="border: 1px solid var(--line); background: var(--paper); height: 110px; padding: 8px; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px"><div class="bar" style="width: 70%"></div><div class="bar" style="width: 40%; background: var(--ink); height: 6px"></div></div>
          <div style="border: 1px solid var(--line); background: var(--paper); height: 110px; padding: 8px; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px"><div class="bar" style="width: 60%"></div><div class="bar" style="width: 40%; background: var(--ink); height: 6px"></div></div>
          <div style="border: 1px solid var(--accent); background: var(--paper); height: 110px; padding: 8px; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px"><div class="bar" style="width: 65%"></div><div class="bar" style="width: 40%; background: var(--accent); height: 6px"></div></div>
        </div>
        </div>
      </div>
      <div class="meta"><span class="lbl">Digital Commerce</span><p>Storefronts, catalogues, payments and fulfilment.</p></div>
    </div>
    <div class="bc s3">
      <div class="frag">
        <div class="win mono" style="margin-bottom: -20px; font-size: 11px; color: var(--muted)">
          <div class="tb"><i></i><i></i><i></i><span class="mk" style="margin-left: 6px">deploy.log</span></div>
          <div style="padding: 12px 14px; display: flex; flex-direction: column; gap: 6px; line-height: 1.5">
            <span>$ deploy --env production</span>
            <span>→ build &nbsp;&nbsp;&nbsp;&nbsp;ok &nbsp;(42s)</span>
            <span>→ migrate &nbsp;&nbsp;ok &nbsp;(3 applied)</span>
            <span style="color: var(--accent)">→ healthy &nbsp;3/3 instances</span>
          </div>
        </div>
      </div>
      <div class="meta"><span class="lbl">Cloud Products</span><p>Multi-tenant services with pipelines and monitoring from day one.</p></div>
    </div>
    <div class="bc s3">
      <div class="frag">
        <div style="width: 100%; display: flex; flex-direction: column; gap: 10px; margin-bottom: -20px">
          <div style="display: flex; justify-content: space-between; align-items: center"><span class="mk" style="color: var(--ink)">Document assistant</span><span class="chip">Grounded · 2 sources</span></div>
          <div style="align-self: flex-end; width: 60%; border: 1px solid var(--line); background: var(--paper); padding: 10px 12px; display: flex; flex-direction: column; gap: 6px"><div class="bar" style="width: 90%"></div><div class="bar" style="width: 55%"></div></div>
          <div style="width: 78%; border: 1px solid var(--line); background: var(--paper); padding: 10px 12px; display: flex; flex-direction: column; gap: 6px"><div class="bar" style="width: 95%"></div><div class="bar" style="width: 80%"></div><div class="bar" style="width: 35%"></div></div>
          <div style="border: 1px solid var(--line); background: var(--paper); height: 36px; display: flex; align-items: center; padding: 0 12px; gap: 10px"><span class="mk" style="flex: 1; text-transform: none; letter-spacing: 0; font-size: 11px">Ask about this contract…</span><div style="width: 20px; height: 20px; background: var(--accent); border-radius: 2px"></div></div>
        </div>
      </div>
      <div class="meta"><span class="lbl">AI-enabled Tools</span><p>Assistants and document pipelines grounded in your own data.</p></div>
    </div>
  </div>
</section>

<!-- 07 — Why Kabeli -->
<section class="wrap" aria-labelledby="h-why" style="padding-bottom: 128px">
  <div class="hair rv"></div>
  <div class="sechead rv" style="padding-top: 48px; padding-bottom: 56px">
    <p class="lbl" style="margin: 0">06 / Why Kabeli</p>
    <div></div>
  </div>
  <div class="why">
    <h2 id="h-why" class="disp rv" style="font-size: clamp(40px, 5vw, 68px); max-width: 560px">Small teams. Direct answers. Software that lasts.</h2>
    <div class="wl rv">
      <div class="wi"><span class="mono" style="font-size: 12px; color: var(--accent)">01</span><h3 class="disp" style="font-size: 20px; letter-spacing: -0.015em">Small, focused teams</h3><p>The people who scope the work are the people who build it.</p></div>
      <div class="wi"><span class="mono" style="font-size: 12px; color: var(--accent)">02</span><h3 class="disp" style="font-size: 20px; letter-spacing: -0.015em">Direct communication</h3><p>You work directly with the people responsible for the technical decisions.</p></div>
      <div class="wi"><span class="mono" style="font-size: 12px; color: var(--accent)">03</span><h3 class="disp" style="font-size: 20px; letter-spacing: -0.015em">Business-first engineering</h3><p>We start from the process, not the technology, and say so when something isn't worth building.</p></div>
      <div class="wi"><span class="mono" style="font-size: 12px; color: var(--accent)">04</span><h3 class="disp" style="font-size: 20px; letter-spacing: -0.015em">Long-term technical thinking</h3><p>Boring, well-documented choices that a future team can pick up without us.</p></div>
      <div class="wi"><span class="mono" style="font-size: 12px; color: var(--accent)">05</span><h3 class="disp" style="font-size: 20px; letter-spacing: -0.015em">Scalable architecture</h3><p>Designed to scale without over-engineering from day one.</p></div>
      <div class="wi"><span class="mono" style="font-size: 12px; color: var(--accent)">06</span><h3 class="disp" style="font-size: 20px; letter-spacing: -0.015em">International delivery</h3><p>Based in the UAE and structured for international delivery.</p></div>
    </div>
  </div>
</section>

<!-- 08 — Company -->
