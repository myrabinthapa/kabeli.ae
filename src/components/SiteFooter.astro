---
// Site footer for secondary pages.
---
<footer class="wrap" style="border-top: 1px solid var(--line)">
  <div class="foot">
    <div style="display: flex; flex-direction: column; gap: 16px">
      <div style="display: flex; align-items: center; gap: 12px">
        <svg width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true"><rect x="2" y="1" width="4" height="20" fill="#141516"></rect><path d="M9 11 L19 1 L19 6.5 L14.5 11 L19 15.5 L19 21 Z" fill="var(--accent)"></path></svg>
        <span style="font-family: Manrope, system-ui, sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 0.22em">KABELI</span>
      </div>
      <p>Kabeli Software Solution FZ-LLC<br>Ras Al Khaimah, United Arab Emirates</p>
    </div>
    <div style="display: flex; flex-direction: column; gap: 14px"><span class="lbl">Site</span>
      <ul><li><a class="ul" href="/#services">Services</a></li><li><a class="ul" href="/#expertise">Expertise</a></li><li><a class="ul" href="/#company">Company</a></li><li><a class="ul" href="/contact">Contact</a></li></ul>
    </div>
    <div style="display: flex; flex-direction: column; gap: 14px"><span class="lbl">Legal</span>
      <ul><li><a class="ul" href="/privacy">Privacy</a></li><li><a class="ul" href="/terms">Terms</a></li></ul>
    </div>
  </div>
  <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding: 20px 0 32px; border-top: 1px solid var(--line)">
    <span class="mono" style="font-size: 13px; color: var(--muted)">© 2026 Kabeli Software Solution FZ-LLC</span>
    <span class="mono" style="font-size: 13px; color: var(--muted)">kabeli.ae</span>
  </div>
</footer>
